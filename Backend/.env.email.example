# ============================================
# EMAIL CONFIGURATION FOR REPORTS
# ============================================
# Last Updated: 2026-01-12
# Purpose: Send user reports via email using Gmail SMTP

# Gmail SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Your Gmail Credentials
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password

# Email Addresses
REPORT_EMAIL_FROM=your-email@gmail.com
REPORT_EMAIL_TO=user_reports@daytz.com

# ============================================
# SETUP INSTRUCTIONS
# ============================================
# 
# 1. ENABLE 2-FACTOR AUTHENTICATION:
#    - Go to: https://myaccount.google.com/security
#    - Enable "2-Step Verification"
#
# 2. GENERATE APP PASSWORD:
#    - Go to: https://myaccount.google.com/apppasswords
#    - Select "Mail" and your device
#    - Copy the 16-character password (e.g., "abcd efgh ijkl mnop")
#    - Paste it in SMTP_PASS (without spaces)
#
# 3. UPDATE CREDENTIALS:
#    - Replace "your-email@gmail.com" with your actual Gmail
#    - Replace "your-16-char-app-password" with the app password
#    - Update REPORT_EMAIL_TO if needed
#
# 4. TEST:
#    - Start backend: npm run dev
#    - Test report submission from app
#    - Check email at REPORT_EMAIL_TO
#
# ============================================
